<Window x:Class="SignageVienBa.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SignageVienBa.App"
        Title="Signage Viên Ba" Width="1080" Height="720" MinWidth="880" MinHeight="600"
        WindowStartupLocation="CenterScreen" Style="{StaticResource BaseWindow}"
        AllowDrop="True" PreviewDragEnter="Window_DragEnter" PreviewDragOver="Window_DragOver"
        PreviewDragLeave="Window_DragLeave" PreviewDrop="Window_Drop"
        ContentRendered="Window_ContentRendered" Closing="Window_Closing">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
  </Window.Resources>

  <Grid Margin="28,22,28,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Update strip -->
    <Border Grid.Row="1" Margin="0,16,0,0" Padding="14,10" CornerRadius="10" DataContext="{Binding Update}"
            Background="{StaticResource AccentSoftBrush}" BorderBrush="#CCDAFA" BorderThickness="1"
            Visibility="{Binding Visible, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="Thông báo cập nhật">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
          <Button Style="{StaticResource GhostButton}" Content="{Binding SecondaryText}" Click="UpdateSecondary_Click"
                  Visibility="{Binding SecondaryVisible, Converter={StaticResource BoolToVis}}"/>
          <Button x:Name="UpdateNowButton" Style="{StaticResource PrimaryButton}" Padding="16,8" Margin="6,0,0,0"
                  Content="{Binding PrimaryText}" Click="UpdatePrimary_Click"
                  Visibility="{Binding PrimaryVisible, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>
        <Border Width="32" Height="32" CornerRadius="8" Background="{StaticResource SurfaceBrush}" Margin="0,0,12,0" VerticalAlignment="Center">
          <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="15" Foreground="{StaticResource AccentBrush}"/>
        </Border>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13.5"/>
          <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                     ToolTip="{Binding Detail}" Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}"/>
          <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Width="320" HorizontalAlignment="Left" Margin="0,7,0,2"
                       Visibility="{Binding Downloading, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Header -->
    <DockPanel>
      <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Tag="&#xE713;" Content="Cài đặt"
              VerticalAlignment="Top" Click="Settings_Click"/>
      <StackPanel>
        <TextBlock Text="Đưa nội dung lên TV" FontSize="23" FontWeight="SemiBold"/>
        <TextBlock Style="{StaticResource Muted}" FontSize="13.5" Margin="0,3,0,0"
                   Text="Tòa nhà Viên Ba · chọn TV, thêm ảnh hoặc video, rồi bấm Đưa lên"/>
      </StackPanel>
    </DockPanel>

    <!-- TV picker -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,20,0,18" IsEnabled="{Binding CanSwitchTv}">
      <RadioButton x:Name="Tv1Tab" Style="{StaticResource TvTab}" GroupName="Tv" Tag="1" IsChecked="True"
                   Checked="Tv_Checked" AutomationProperties.Name="TV 1">
        <StackPanel Orientation="Horizontal">
          <Border Style="{StaticResource TvTabIcon}">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE7F4;" FontSize="17"/>
          </Border>
          <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="TV 1" FontSize="15.5" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding Tv1Count}" Style="{StaticResource Muted}"/>
          </StackPanel>
        </StackPanel>
      </RadioButton>
      <RadioButton x:Name="Tv2Tab" Style="{StaticResource TvTab}" GroupName="Tv" Tag="2"
                   Checked="Tv_Checked" AutomationProperties.Name="TV 2">
        <StackPanel Orientation="Horizontal">
          <Border Style="{StaticResource TvTabIcon}">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE7F4;" FontSize="17"/>
          </Border>
          <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="TV 2" FontSize="15.5" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding Tv2Count}" Style="{StaticResource Muted}"/>
          </StackPanel>
        </StackPanel>
      </RadioButton>
    </StackPanel>

    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="20"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- What is on the TV now -->
      <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <DockPanel Margin="20,16,14,12">
            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Tag="&#xE72C;" Content="Làm mới"
                    Click="Refresh_Click" VerticalAlignment="Center"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Style="{StaticResource CardTitle}" Text="{Binding RemoteTitle}"/>
              <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0" Text="Thứ tự chiếu như danh sách dưới đây"/>
            </StackPanel>
          </DockPanel>

          <Border Grid.Row="1" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,1">
            <Grid>
              <ListBox x:Name="RemoteList" Style="{StaticResource PlainList}" ItemsSource="{Binding RemoteItems}"
                       AutomationProperties.Name="Danh sách đang chiếu">
                <ListBox.ItemTemplate>
                  <DataTemplate DataType="{x:Type local:RemoteItem}">
                    <Grid Margin="16,8,12,8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Number}" Style="{StaticResource Muted}" VerticalAlignment="Center"
                                 HorizontalAlignment="Center" FontSize="12"/>
                      <Border Grid.Column="1" Width="34" Height="34" CornerRadius="8" Background="{StaticResource AccentSoftBrush}" Margin="4,0,12,0">
                        <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" Foreground="{StaticResource AccentBrush}" FontSize="15"/>
                      </Border>
                      <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}" FontSize="13.5"/>
                        <TextBlock Text="{Binding KindText}" Style="{StaticResource Muted}" FontSize="12"/>
                      </StackPanel>
                      <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                        <Button Style="{StaticResource GhostButton}" Tag="&#xE8A7;" Content="Xem" Click="View_Click"
                                ToolTip="Mở file này trong trình duyệt"/>
                        <Button Style="{StaticResource DangerGhostButton}" Tag="&#xE74D;" Content="Xóa" Click="Delete_Click"
                                ToolTip="Xóa khỏi TV" Margin="2,0,0,0"/>
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="32"
                          Visibility="{Binding ShowRemoteMessage, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding RemoteMessage}" TextAlignment="Center" TextWrapping="Wrap"
                           Foreground="{StaticResource MutedBrush}" MaxWidth="320"/>
                <Button Style="{StaticResource SecondaryButton}" Content="Thử lại" Margin="0,14,0,0" HorizontalAlignment="Center"
                        Click="Refresh_Click" Visibility="{Binding RemoteFailed, Converter={StaticResource BoolToVis}}"/>
              </StackPanel>
            </Grid>
          </Border>

          <TextBlock Grid.Row="2" Style="{StaticResource Muted}" Margin="20,12,20,14"
                     Text="TV chiếu theo tên file từ A đến Z. Muốn đổi thứ tự, đặt tên bắt đầu bằng 01, 02, 03…"/>
        </Grid>
      </Border>

      <!-- Add content -->
      <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <StackPanel Margin="20,16,20,12">
            <TextBlock Style="{StaticResource CardTitle}" Text="Thêm nội dung"/>
            <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0"
                       Text="Ảnh JPG/PNG giữ nguyên. Video tự chỉnh về khổ dọc 1080×1920, nền mờ, dưới 85 MB."/>
          </StackPanel>

          <!-- Drop zone -->
          <Grid Grid.Row="1" Margin="20,0,20,14" MinHeight="{Binding DropZoneHeight}">
            <Rectangle x:Name="DropRect" RadiusX="10" RadiusY="10" StrokeThickness="1.5" StrokeDashArray="5 4"
                       Stroke="{StaticResource LineStrongBrush}" Fill="#FAFBFD"/>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16,14">
              <TextBlock x:Name="DropIcon" Style="{StaticResource Icon}" Text="&#xE898;" FontSize="24"
                         Foreground="{StaticResource AccentBrush}"
                         Visibility="{Binding QueueEmpty, Converter={StaticResource BoolToVis}}"/>
              <TextBlock x:Name="DropText" Text="Kéo thả ảnh, video hoặc cả thư mục vào đây" HorizontalAlignment="Center"
                         Margin="0,8,0,12" FontSize="13.5"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Style="{StaticResource SecondaryButton}" Tag="&#xE8E5;" Content="Chọn file…" Click="PickFiles_Click"/>
                <Button Style="{StaticResource SecondaryButton}" Tag="&#xE8B7;" Content="Chọn thư mục…" Click="PickFolder_Click" Margin="8,0,0,0"/>
              </StackPanel>
            </StackPanel>
          </Grid>

          <!-- Queue -->
          <Border Grid.Row="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,1"
                  Visibility="{Binding QueueHasItems, Converter={StaticResource BoolToVis}}">
            <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Queue}" AutomationProperties.Name="Danh sách chờ">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type local:QueueItem}">
                  <Grid Margin="16,9,10,9">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="KindBox" Width="34" Height="34" CornerRadius="8" Background="{StaticResource BgBrush}" Margin="0,0,12,0" VerticalAlignment="Top">
                      <TextBlock x:Name="KindGlyph" Style="{StaticResource Icon}" Text="{Binding Glyph}" Foreground="{StaticResource MutedBrush}" FontSize="15"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding TargetName}" TextTrimming="CharacterEllipsis" FontSize="13.5"
                                 ToolTip="{Binding SourcePath}"/>
                      <TextBlock x:Name="StatusText" Text="{Binding Status}" Style="{StaticResource Muted}" FontSize="12" Margin="0,1,0,0"/>
                      <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Margin="0,6,0,1"
                                   Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource GhostButton}" Tag="&#xE711;" Padding="8,6" VerticalAlignment="Center"
                            ToolTip="Bỏ khỏi danh sách" Click="RemoveQueued_Click" Margin="6,0,0,0"
                            AutomationProperties.Name="Bỏ khỏi danh sách"
                            Visibility="{Binding CanRemove, Converter={StaticResource BoolToVis}}"/>
                  </Grid>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding State}" Value="Done">
                      <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                      <Setter TargetName="KindGlyph" Property="Text" Value="&#xE73E;"/>
                      <Setter TargetName="KindGlyph" Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                      <Setter TargetName="KindBox" Property="Background" Value="#ECF8F0"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State}" Value="Failed">
                      <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource DangerBrush}"/>
                      <Setter TargetName="KindGlyph" Property="Text" Value="&#xE783;"/>
                      <Setter TargetName="KindGlyph" Property="Foreground" Value="{StaticResource DangerBrush}"/>
                      <Setter TargetName="KindBox" Property="Background" Value="{StaticResource DangerSoftBrush}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State}" Value="Running">
                      <Setter TargetName="StatusText" Property="Foreground" Value="{StaticResource AccentBrush}"/>
                      <Setter TargetName="KindGlyph" Property="Foreground" Value="{StaticResource AccentBrush}"/>
                      <Setter TargetName="KindBox" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>

          <!-- Empty queue hint fills the space -->
          <TextBlock Grid.Row="2" Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                     TextAlignment="Center" Margin="30" MaxWidth="340"
                     Visibility="{Binding QueueEmpty, Converter={StaticResource BoolToVis}}"
                     Text="Các file bạn thêm sẽ hiện ở đây. Video sẽ được nén trên máy này trước khi đưa lên, nên có thể mất vài phút."/>

          <DockPanel Grid.Row="3" Margin="20,14,20,16" LastChildFill="True">
            <Button DockPanel.Dock="Right" x:Name="StartButton" Style="{StaticResource PrimaryButton}" Tag="&#xE898;"
                    Content="{Binding StartText}" Click="Start_Click" IsEnabled="{Binding CanStart}"
                    Visibility="{Binding IsIdle, Converter={StaticResource BoolToVis}}"/>
            <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Tag="&#xE71A;" Content="Dừng"
                    Click="Stop_Click" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
              <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontSize="13"/>
              <Button Style="{StaticResource GhostButton}" Content="Dọn danh sách đã xong" Padding="0,4" HorizontalAlignment="Left"
                      Foreground="{StaticResource AccentBrush}" Click="ClearFinished_Click"
                      Visibility="{Binding HasFinished, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
          </DockPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
