<Window x:Class="SignageVienBa.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cài đặt" Width="500" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Style="{StaticResource BaseWindow}" Background="{StaticResource SurfaceBrush}">
  <StackPanel Margin="28,24,28,24">
    <TextBlock Text="Cài đặt kết nối" FontSize="19" FontWeight="SemiBold"/>
    <TextBlock x:Name="Intro" Style="{StaticResource Muted}" FontSize="13" Margin="0,4,0,0"
               Text="Chỉ cần nhập một lần trên máy này. Mã API được mã hóa, chỉ dùng được với tài khoản Windows này."/>

    <TextBlock Text="Địa chỉ máy chủ" FontWeight="SemiBold" FontSize="13" Margin="0,20,0,6"/>
    <Border Style="{StaticResource InputBorder}">
      <TextBox x:Name="UrlBox" AutomationProperties.Name="Địa chỉ máy chủ"/>
    </Border>

    <TextBlock Text="Mã API" FontWeight="SemiBold" FontSize="13" Margin="0,16,0,6"/>
    <Border Style="{StaticResource InputBorder}">
      <PasswordBox x:Name="KeyBox" AutomationProperties.Name="Mã API"/>
    </Border>
    <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" Text="Hỏi bộ phận IT nếu bạn chưa có mã này."/>

    <DockPanel Margin="0,18,0,0">
      <Button x:Name="CheckButton" Style="{StaticResource SecondaryButton}" Tag="&#xE703;" Content="Kiểm tra kết nối"
              Click="Check_Click" VerticalAlignment="Top"/>
      <TextBlock x:Name="CheckResult" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="13"/>
    </DockPanel>

    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,22,0,0" Padding="0,16,0,0">
      <DockPanel>
        <Button x:Name="UpdateCheckButton" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Tag="&#xE895;"
                Content="Kiểm tra bản mới" Click="CheckUpdate_Click" VerticalAlignment="Top"/>
        <StackPanel>
          <TextBlock x:Name="VersionText" FontSize="13" FontWeight="SemiBold"/>
          <TextBlock x:Name="UpdateResult" Style="{StaticResource Muted}" Margin="0,2,0,0"
                     Text="Phần mềm tự tìm bản mới mỗi khi mở."/>
        </StackPanel>
      </DockPanel>
    </Border>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
      <Button Style="{StaticResource SecondaryButton}" Content="Hủy" IsCancel="True" MinWidth="90"/>
      <Button Style="{StaticResource PrimaryButton}" Content="Lưu" IsDefault="True" Click="Save_Click" MinWidth="90" Margin="8,0,0,0"/>
    </StackPanel>
  </StackPanel>
</Window>
