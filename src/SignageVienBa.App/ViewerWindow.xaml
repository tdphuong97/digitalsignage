<Window x:Class="SignageVienBa.App.ViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Xem · Signage Viên Ba" Width="560" Height="900" MinWidth="380" MinHeight="420"
        WindowStartupLocation="CenterOwner" Style="{StaticResource BaseWindow}" Background="{StaticResource SurfaceBrush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="18,11,14,11">
      <DockPanel>
        <Button x:Name="CopyButton" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Tag="&#xE8C8;"
                Content="Chép link" Padding="12,7" VerticalAlignment="Center" Click="Copy_Click"
                ToolTip="Chép link này để mở trên máy khác hoặc trên TV"/>
        <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
          <TextBlock x:Name="Heading" FontWeight="SemiBold" FontSize="14.5" TextTrimming="CharacterEllipsis"/>
          <TextBox x:Name="LinkBox" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" Margin="-2,3,0,0"
                   Foreground="{StaticResource MutedBrush}" FontSize="12.5" AutomationProperties.Name="Link"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Row="1" Background="#15181D">
      <TextBlock x:Name="Loading" Text="Đang mở…" Foreground="#A3AAB6" FontSize="14"
                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
      <wv2:WebView2 x:Name="Web" Visibility="Hidden"/>
    </Grid>
  </Grid>
</Window>
