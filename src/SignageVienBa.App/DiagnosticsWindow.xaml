<Window x:Class="SignageVienBa.App.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SignageVienBa.App"
        Title="Chẩn đoán · Signage Viên Ba" Width="660" Height="780" MinWidth="520" MinHeight="460"
        WindowStartupLocation="CenterOwner" Style="{StaticResource BaseWindow}">
  <Window.Resources>
    <SolidColorBrush x:Key="WarnBrush" Color="#B45309"/>
    <SolidColorBrush x:Key="WarnSoftBrush" Color="#FEF6E7"/>
    <SolidColorBrush x:Key="OkSoftBrush" Color="#ECF8F0"/>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
  </Window.Resources>

  <Grid Margin="24,20,24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="Chẩn đoán" FontSize="21" FontWeight="SemiBold"/>
      <TextBlock x:Name="SummaryText" FontSize="14.5" FontWeight="SemiBold" Margin="0,6,0,0" Text="Đang kiểm tra…"
                 AutomationProperties.AutomationId="DiagnosisSummary"/>
      <TextBlock x:Name="SummaryDetail" Style="{StaticResource Muted}" FontSize="13" Margin="0,2,0,0" TextWrapping="Wrap"
                 Text="Kiểm tra kết nối, mã API, nội dung trên 2 TV và máy này."/>
    </StackPanel>

    <Border Grid.Row="1" Margin="0,16,0,16" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}"
            BorderThickness="1" CornerRadius="12">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Rows}" AutomationProperties.Name="Kết quả chẩn đoán">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type local:CheckRow}">
              <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="16,12,18,12">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Border x:Name="Badge" Width="30" Height="30" CornerRadius="15" Background="{StaticResource BgBrush}" VerticalAlignment="Top">
                    <TextBlock x:Name="Mark" Style="{StaticResource Icon}" Text="&#xE895;" FontSize="14" Foreground="{StaticResource MutedBrush}"/>
                  </Border>
                  <StackPanel Grid.Column="1" Margin="14,0,0,0">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontSize="13" Margin="0,2,0,0"/>
                    <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"
                               Visibility="{Binding HasFix, Converter={StaticResource BoolToVis}}">
                      <Run Text="Cách xử lý: " FontWeight="SemiBold"/><Run Text="{Binding Fix, Mode=OneWay}"/>
                    </TextBlock>
                  </StackPanel>
                </Grid>
              </Border>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Ok">
                  <Setter TargetName="Mark" Property="Text" Value="&#xE73E;"/>
                  <Setter TargetName="Mark" Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                  <Setter TargetName="Badge" Property="Background" Value="{StaticResource OkSoftBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Warning">
                  <Setter TargetName="Mark" Property="Text" Value="&#xE7BA;"/>
                  <Setter TargetName="Mark" Property="Foreground" Value="{StaticResource WarnBrush}"/>
                  <Setter TargetName="Badge" Property="Background" Value="{StaticResource WarnSoftBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Error">
                  <Setter TargetName="Mark" Property="Text" Value="&#xE711;"/>
                  <Setter TargetName="Mark" Property="Foreground" Value="{StaticResource DangerBrush}"/>
                  <Setter TargetName="Badge" Property="Background" Value="{StaticResource DangerSoftBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Skipped">
                  <Setter TargetName="Mark" Property="Text" Value="&#xE738;"/>
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <DockPanel Grid.Row="2">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="CopyButton" Style="{StaticResource SecondaryButton}" Tag="&#xE8C8;" Content="Chép kết quả"
                Click="Copy_Click" IsEnabled="False"/>
        <Button x:Name="RerunButton" Style="{StaticResource PrimaryButton}" Tag="&#xE72C;" Content="Chạy lại"
                Click="Rerun_Click" IsEnabled="False" Margin="8,0,0,0"/>
      </StackPanel>
      <TextBlock Style="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0"
                 Text="Chép kết quả để gửi cho IT. Kết quả không chứa mã API."/>
    </DockPanel>
  </Grid>
</Window>
