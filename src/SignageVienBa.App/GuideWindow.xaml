        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Hướng dẫn sử dụng · Signage Viên Ba" Width="1100" Height="760" MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterOwner" Style="{StaticResource BaseWindow}" Background="{StaticResource SurfaceBrush}">
  <Grid>
    <TextBlock x:Name="Loading" Text="Đang mở hướng dẫn…" Style="{StaticResource Muted}" FontSize="14"
